# Copy to .env.local for local development. Never commit real values.
# Every variable below is REQUIRED.

# Postgres connection string (Neon free tier). Used by the app and drizzle-kit.
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Password that gates the whole app (login page). Pick something long.
APP_PASSWORD="change-me-to-a-long-random-password"

# 32-byte key for AES-256-GCM retailer credential encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Accepts 64 hex chars or base64. If you lose this, saved retailer logins cannot be decrypted.
ENCRYPTION_KEY="paste-64-hex-chars-here"

# Bearer token guarding POST /api/cron/process. Must match the GitHub repo secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="paste-a-long-random-token-here"

# Public URL of the deployed app (used for logout redirect + the cron workflow target).
APP_URL="https://your-app.vercel.app"
